sequenceDiagram
    participant User as User
    participant UI as UI
    participant GE as GameEngine
    participant LocalP as LocalNetworkPlayer
    participant RemoteP as RemoteNetworkPlayer
    participant Game as Game
    participant Board as Board
    participant Transport as TcpTransport

    activate GE
    GE->>LocalP: start_turn()
    activate LocalP
    LocalP->>UI: enable_input() via callback
    activate UI
    deactivate UI
    UI-->>LocalP:
    LocalP-->>GE:
    deactivate LocalP

    User->>UI: Enters move
    activate UI
    UI->>UI: Interpret & validate input
    UI->>UI: _queue_move(row, col)
    UI->>GE: queue_move(row, col)
    GE->>LocalP: queue_move(row, col)
    LocalP->>Transport: send({"type": "move_request", "row": row, "col": col})
    deactivate UI

    activate Transport
    Transport->>Transport: Receive msg in _recv_loop()
    Transport->>Transport: _dispatch(msg)
    Transport->>RemoteP: _handle_move_request(msg)
    activate RemoteP
    RemoteP->>RemoteP: Validate move (Board.validate_move)
    RemoteP->>Transport: send({"type": "move_ack", "ok": true})
    RemoteP->>RemoteP: queue_move(row, col)
    Transport->>Transport: Receive msg in _recv_loop()
    Transport->>Transport: _dispatch(msg)
    deactivate RemoteP
    Transport-->>LocalP: _handle_move_ack(msg)
    deactivate Transport
    LocalP->>LocalP: queue_move(row, col) after ack

    GE->>GE: _game_loop() in background thread
    loop Each tick
        GE->>LocalP: get_pending_move(block=True)
        LocalP-->>GE: (row, col)
        GE->>Game: apply_move(Move(symbol, row, col))
        activate Game
        Game->>Board: apply_move(move)
        activate Board
        Board->>Board: validate_move()
        Board-->>Game:
        deactivate Board
        Game->>Game: Switch current player
        Game-->>GE:
        deactivate Game

        GE->>GE: _notify_board_updated()
        GE->>UI: on_board_updated()
        activate UI
        UI->>UI: _render_board()
        UI->>User: Display updated board
        UI->>UI: Check winner/draw
        deactivate UI

        GE->>GE: if not game over -> current_player.start_turn()
        note over GE: Remote player's start_turn() is a noop
    end
    deactivate GE
