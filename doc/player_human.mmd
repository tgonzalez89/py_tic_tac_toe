sequenceDiagram
    participant User as User
    participant UI as UI
    participant GE as GameEngine
    participant LocalP as LocalPlayer
    participant Game as Game
    participant Board as Board

    activate GE
    GE->>LocalP: start_turn()
    activate LocalP
    LocalP->>UI: enable_input() via callback
    activate UI
    deactivate UI
    UI-->>LocalP:
    LocalP-->>GE:
    deactivate LocalP

    User->>UI: Enters move
    activate UI
    UI->>UI: Interpret & validate input
    UI->>UI: _queue_move(row, col)
    UI->>GE: queue_move(row, col)
    GE->>LocalP: queue_move(row, col)
    deactivate UI

    GE->>GE: _game_loop() in background thread
    loop Each tick
        GE->>LocalP: get_pending_move(block=True)
        LocalP-->>GE: (row, col)
        GE->>LocalP: apply_move(row, col)
        activate LocalP
        LocalP->>Game: validate_and_apply_move(Move(symbol, row, col))
        activate Game
        Game->>Game: validate_move(move)
        Game->>Board: validate_move(move)
        activate Board
        Board-->>Game:
        deactivate Board
        Game->>Game: apply_move(move)
        Game->>Board: apply_move(move)
        activate Board
        Board-->>Game:
        deactivate Board
        Game->>Game: Switch current player
        Game-->>LocalP:
        deactivate Game
        LocalP-->>GE:
        deactivate LocalP

        GE->>GE: _notify_board_updated()
        GE->>UI: on_board_updated()
        activate UI
        UI->>UI: _render_board()
        UI->>User: Display updated board
        UI->>UI: Check winner/draw
        deactivate UI

        GE->>GE: if not game over -> current_player.start_turn()
    end
    deactivate GE
