sequenceDiagram
    participant UI as UI
    participant GE as GameEngine
    participant AiP as AiPlayer
    participant Game as Game
    participant Board as Board

    activate GE
    GE->>AiP: start_turn()
    activate AiP
    AiP->>AiP: row, col = _find_move()
    AiP->>AiP: queue_move(row, col)
    deactivate AiP

    GE->>GE: _game_loop() in background thread
    loop Each tick
        GE->>AiP: get_pending_move(block=True)
        AiP-->>GE: (row, col)
        GE->>Game: apply_move(Move(symbol, row, col))
        activate Game
        Game->>Board: apply_move(move)
        activate Board
        Board->>Board: validate_move()
        Board-->>Game:
        deactivate Board
        Game->>Game: Switch current player
        Game-->>GE:
        deactivate Game

        GE->>GE: _notify_board_updated()
        GE->>UI: on_board_updated()
        activate UI
        UI->>UI: _render_board()
        UI->>UI: Check winner/draw
        deactivate UI

        GE->>GE: if not game over -> current_player.start_turn()
    end
    deactivate GE
